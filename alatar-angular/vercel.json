{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "installCommand": "npm i",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/alatar-angular/browser",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(js|css|woff2|webp|png|jpg|jpeg|svg|ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/gallery",
      "destination": "/index.csr.html"
    },
    {
      "source": "/stations",
      "destination": "/index.csr.html"
    },
    {
      "source": "/admin/site-images",
      "destination": "/index.csr.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
